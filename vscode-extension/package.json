{
  "name": "emocis-vscode",
  "displayName": "EMOCIS — Codebase Intelligence & Engineering Memory",
  "description": "Interactive Logic Graph (CCLG), Architecture Drift Detection, and Engineering Memory System for VS Code & Cursor",
  "version": "0.2.0",
  "publisher": "emocis",
  "repository": {
    "type": "git",
    "url": "https://github.com/emocis/emocis"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "emocis-sidebar",
          "title": "EMOCIS",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "emocis-sidebar": [
        {
          "id": "emocis.memoryView",
          "name": "Engineering Memory (TOC)",
          "icon": "media/sidebar-icon.svg",
          "visibility": "visible"
        },
        {
          "id": "emocis.healthView",
          "name": "Architecture Health & Drift",
          "icon": "media/sidebar-icon.svg",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "emocis.openLocation",
        "title": "EMOCIS: Open Code Location",
        "category": "EMOCIS"
      },
      {
        "command": "emocis.refresh",
        "title": "Refresh Memory Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "emocis.search",
        "title": "EMOCIS: Search Engineering Memory",
        "icon": "$(search)"
      },
      {
        "command": "emocis.showGraph",
        "title": "EMOCIS: Show Logic Graph (CCLG Visualizer)",
        "icon": "$(graph)"
      },
      {
        "command": "emocis.analyzeImpact",
        "title": "EMOCIS: Analyze Symbol Impact",
        "icon": "$(pulse)"
      },
      {
        "command": "emocis.copyContext",
        "title": "EMOCIS: Copy Minimal Context Package for AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "emocis.copilotContextForSymbol",
        "title": "EMOCIS: Copilot Context for Active Symbol",
        "icon": "$(robot)"
      },
      {
        "command": "emocis.setupAntigravityMcp",
        "title": "EMOCIS: Setup Antigravity & Copilot MCP Config",
        "icon": "$(gear)"
      },
      {
        "command": "emocis.audit",
        "title": "EMOCIS: Run Architecture Audit",
        "icon": "$(shield)"
      },
      {
        "command": "emocis.sendIssueToChat",
        "title": "EMOCIS: Send Issue to AI Copilot Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "emocis.sendMetricToChat",
        "title": "EMOCIS: Analyze Metric with AI Copilot",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "emocis.sendAllDriftToChat",
        "title": "EMOCIS: Send All Drift Issues to AI Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "emocis.sendFullAuditToChat",
        "title": "EMOCIS: Send Full Health & Drift Audit to AI Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "emocis.sendMemoryToChat",
        "title": "EMOCIS: Send Memory Note to AI Chat",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "emocis.sendFullAuditToChat",
          "when": "view == emocis.healthView",
          "group": "navigation@1"
        },
        {
          "command": "emocis.refresh",
          "when": "view == emocis.memoryView || view == emocis.healthView",
          "group": "navigation@2"
        },
        {
          "command": "emocis.showGraph",
          "when": "view == emocis.memoryView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "emocis.sendIssueToChat",
          "when": "view == emocis.healthView && viewItem == healthIssue",
          "group": "inline"
        },
        {
          "command": "emocis.sendIssueToChat",
          "when": "view == emocis.healthView && viewItem == healthIssue",
          "group": "emocis@1"
        },
        {
          "command": "emocis.openLocation",
          "when": "view == emocis.healthView && viewItem == healthIssue",
          "group": "emocis@2"
        },
        {
          "command": "emocis.sendMetricToChat",
          "when": "view == emocis.healthView && viewItem == healthMetric",
          "group": "inline"
        },
        {
          "command": "emocis.sendMetricToChat",
          "when": "view == emocis.healthView && viewItem == healthMetric",
          "group": "emocis@1"
        },
        {
          "command": "emocis.sendAllDriftToChat",
          "when": "view == emocis.healthView && viewItem == healthGroup",
          "group": "inline"
        },
        {
          "command": "emocis.sendAllDriftToChat",
          "when": "view == emocis.healthView && viewItem == healthGroup",
          "group": "emocis@1"
        },
        {
          "command": "emocis.sendMemoryToChat",
          "when": "view == emocis.memoryView && viewItem == memoryItem",
          "group": "inline"
        },
        {
          "command": "emocis.sendMemoryToChat",
          "when": "view == emocis.memoryView && viewItem == memoryItem",
          "group": "emocis@1"
        }
      ],
      "editor/context": [
        {
          "command": "emocis.copilotContextForSymbol",
          "group": "emocis@1"
        },
        {
          "command": "emocis.analyzeImpact",
          "group": "emocis@2"
        },
        {
          "command": "emocis.showGraph",
          "group": "emocis@3"
        }
      ]
    },
    "configuration": {
      "title": "EMOCIS",
      "properties": {
        "emocis.cliPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the emocis / project binary if not installed globally or via bun."
        },
        "emocis.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show engineering memory badges and caller counts above functions."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --target=node --format=cjs --outfile=./dist/extension.js --external vscode",
    "watch": "bun build ./src/extension.ts --target=node --format=cjs --outfile=./dist/extension.js --external vscode --watch",
    "package": "bunx @vscode/vsce package",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "bun-types": "^1.4.4",
    "typescript": "^5.0.0"
  }
}
